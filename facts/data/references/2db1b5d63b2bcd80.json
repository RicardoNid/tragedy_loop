  "tables": [
    [
      [
        "Q：惨剧轮回是个怎样的游戏？",
        "A：轮回系惨剧体感型推理桌游（不是跑团）"
      ],
      [
        "Q：双方的胜利条件是什么/要怎么赢？",
        "A：如果在某轮回中主人公没有达成失败条件，或在每个轮回都失败后，在最终决战中猜对所有人的身份，主人公获胜，否则剧作家获胜。"
      ],
      [
        "Q：我应该放水吗？",
        "A：游戏本身不建议放水，你想放随便"
      ],
      [
        "Q：剧本页要怎么看？",
        "A：请参考剧作家之书"
      ],
      [
        "Q：剧本怎么没规定能不能讨论啊？",
        "A：剧作家根据主人公能力自行规定并填入公开情报表"
      ],
      [
        "Q：剧本怎么写轮回次数啊？",
        "A：剧作家根据主人公能力，从剧本名字那页下面第一行里选一个合适的轮回数填入公开情报表"
      ],
      [
        "Q：开局之前我要念剧本名和故事吗？",
        "A：不念，会剧透"
      ],
      [
        "Q：那开局的时候应该跟主人公说什么？",
        "A：只给他们看剧本的公开情报表"
      ],
      [
        "Q：角色也不放吗？",
        "A：角色在每轮时之缝隙讨论之后，轮回准备时再放"
      ],
      [
        "Q：每轮限1次是什么？",
        "A：每轮回只能用1次，牌和角色能力都有"
      ],
      [
        "Q：角色和卡牌有什么区别？",
        "A：角色一般指代活人，卡牌无论生死"
      ],
      [
        "Q：模组里的上限是什么？",
        "A：选完规则X和Y组合之后剧本中最多存在那个身份的数量（与规则选择和游戏过程中的变化无关）"
      ],
      [
        "Q：也就是说游戏过程中某个角色身份数可以超过模组规定的上限？",
        "A：可以"
      ],
      [
        "Q：不死是什么？",
        "A：【强制：常驻】该角色不会死亡。"
      ],
      [
        "Q：无视友好是什么？",
        "A：【任意能力：主人公能力阶段】该角色可以拒绝主人公的友好能力请求。"
      ],
      [
        "Q：必定无视友好是什么？",
        "A：【强制：主人公能力阶段】该角色必须拒绝主人公的友好能力请求。"
      ],
      [
        "Q：必定无视友好是无视友好吗？",
        "A：是"
      ],
      [
        "Q：可以在游戏中途跳过中间的任意轮回数，从最终轮回开始游戏吗？",
        "A：不能，只能选择跳过所有剩余轮回进入最终决战"
      ],
      [
        "Q：第一个轮回开始之前有时间缝隙!?",
        "A：有"
      ],
      [
        "Q：轮回数可以不够再加吗？",
        "A：不能"
      ],
      [
        "Q：被移除的幻想和希望+1如何处理？",
        "A：将被移除的卡牌放置于固定位置，视为除外区，双方玩家都可以随时确认除外区中的卡牌（和其上的指示物）"
      ]
    ],
    [
      [
        "Q：能给尸体打行动牌吗？",
        "A：不能，除非写明可以"
      ],
      [
        "Q：是不是有无视友好的角色就不能放友好指示物了？",
        "A：不是，友好指示物该怎么放就怎么放，友好无视只在主人公能力阶段起效"
      ],
      [
        "Q：移动和加减哪个先？",
        "A：先移动后加减"
      ],
      [
        "Q：两个移动叠加了怎么结算？",
        "A：按移动牌下方的括号，当做一张移动卡结算"
      ],
      [
        "Q：两个移动叠加了之后角色会移动到禁行区域，是不是只结算其中一张？",
        "A：都不结算"
      ],
      [
        "Q：能不能通过移动牌把角色移动到禁行区域？",
        "A：不能"
      ],
      [
        "Q：禁止移动是移动牌吗？",
        "A：是广义上的移动牌"
      ],
      [
        "Q：不安+1和不安-1同时放了怎么结算？",
        "A：先+后-"
      ],
      [
        "Q：为什么主人公有不安+1/为什么剧作家有不安-1？",
        "A：就是有，总有一天会用到"
      ],
      [
        "Q：是不是在行动阶段打了禁止密谋之后，能力阶段就不能往角色身上放密谋了？",
        "A：不是，禁止密谋仅在行动阶段生效"
      ]
    ],
    [
      [
        "Q：剧作家能发动友好能力吗？",
        "A：没写就不能"
      ],
      [
        "Q：那为什么剧作家之书的FAQ里写了剧作家能发医生的能力？",
        "A：看看医生的角色牌？"
      ],
      [
        "Q：剧作家发动医生的能力之后，主人公在同一天还能发动医生的能力吗？",
        "A：能"
      ],
      [
        "Q：剧作家发动能力时怎么声明？",
        "A：不声明能力是由谁或什么效果发动的，只将会有的现象（指示物的变化、位置的变化、生死等）描述出来"
      ],
      [
        "Q：剧作家能力能无限发动吗？",
        "A：一般情况下，每个剧作家能发动的能力可以在对应阶段发动1次"
      ],
      [
        "Q：能对尸体发动能力吗？",
        "A：不能，除非写明可以"
      ],
      [
        "Q：是不是在行动阶段打了禁止密谋之后，能力阶段就不能往角色身上放密谋了？",
        "A：不是，禁止密谋仅在行动阶段生效"
      ],
      [
        "Q：能不能通过剧作家能力把角色移动到禁行区域？",
        "A：不能"
      ],
      [
        "Q：剧作家能力阶段的能力怎么结算？",
        "A：先强制后可选"
      ]
    ],
    [
      [
        "Q：友好能力要怎么发动？",
        "A：活着，身上的友好要够，其他看主人公之书"
      ],
      [
        "Q：友好能力能空发吗？",
        "A：按主人公之书里友好能力的处理，如果可以就能空发"
      ],
      [
        "Q：能对尸体发动能力吗？",
        "A：不能，除非写明可以"
      ],
      [
        "Q：可以在同一天发一个角色的两个能力吗？",
        "A：可以"
      ],
      [
        "Q：可以在本阶段给一个角色加了友好指示物之后发那个角色的能力吗？",
        "A：可以"
      ],
      [
        "Q：友好无视要怎么用？",
        "A：在主人公声明完能力的发动之后决定是否拒绝，或必须拒绝（如果是必定友好无视）"
      ],
      [
        "Q：拒绝的时候是不是什么都不用说？",
        "A：可以说没有现象"
      ],
      [
        "Q：能不能通过友好能力把角色移动到禁行区域？",
        "A：不能"
      ],
      [
        "Q：友好能力能无限发动吗？",
        "A：如果没有每轮限1次，每个友好能力可以在主人公能力阶段发动1次"
      ]
    ],
    [
      [
        "Q：一天可以有多个事件吗？",
        "A：不能，除非写明可以"
      ],
      [
        "Q：同一个角色可以担任多个事件的当事人吗？",
        "A：不能，除非写明可以"
      ],
      [
        "Q：同一个事件可以有多个当事人吗？",
        "A：不能，特殊例子请参考临时工的QA"
      ],
      [
        "Q：是不是事件触发了主人公就输了？",
        "A：不是"
      ],
      [
        "Q：事件的当事人是不是跟角色身份有关？",
        "A：不是"
      ],
      [
        "Q：一般情况下事件是怎么触发的？",
        "A：事件发生当天的事件阶段，剧本规定的当事人存活，且那个当事人角色身上的不安指示物数量达到或超过不安限度"
      ],
      [
        "Q：能不能通过事件把角色移动到禁行区域？",
        "A：不能"
      ],
      [
        "Q：事件要怎么声明？",
        "A：首先声明发没发生，如果发生了，将现象（指示物的变化、位置的变化、生死等）描述出来"
      ],
      [
        "Q：如果事件发生了但没现象呢？声明没发生？",
        "A：声明事件发生了，但是没有现象"
      ],
      [
        "Q：能对尸体结算事件吗？",
        "A：不能，除非写明可以"
      ],
      [
        "Q：如果在事件阶段途中关键人物或主人公死亡，如何结算？",
        "A：触发角色死亡时发动的强制能力，并终止一切后续结算，主人公失败（如果主人公死亡需宣言），然后进行轮回结束时的处理"
      ],
      [
        "Q：如果在事件阶段途中当事人死亡，如何结算？",
        "A：一般情况下会继续结算，如果在继续结算的中途发现需要检测当事人位置时，视为没有位置"
      ]
    ],
    [
      [
        "Q：回合结束阶段的能力怎么结算？",
        "A：先强制后可选"
      ],
      [
        "Q：具体是怎么操作的？",
        "A：强制A强制B同时发动，可选C，可选D。"
      ]
    ],
    [
      [
        "Q：轮回结束时具体要怎么声明主人公失败了？",
        "A：声明：轮回结束，进行胜负判定，主人公失败"
      ]
    ],
    [
      [
        "Q：是不是在轮回中达成了失败条件主人公就失败了？",
        "A：在对应失败条件的时间点达成失败条件主人公才失败"
      ],
      [
        "Q：主人公死亡是不是也是主人公失败？",
        "A：是，但是需要额外声明：主人公死亡"
      ]
    ],
    [
      [
        "Q：远方是什么？",
        "A：远方没有版图，在远方的所有角色视为在同一个区域，在远方的角色身上放置的移动牌失效。"
      ],
      [
        "Q：手下的初始区域可以选远方吗？",
        "A：不能"
      ],
      [
        "Q：双胞胎在远方触发了事件，如何结算？",
        "A：视为在远方进行结算。"
      ]
    ],
    [
      [
        "Q：希望和绝望是什么？",
        "A：十周年新机制"
      ],
      [
        "Q：希望+1可以被友好禁止吗？",
        "A：不能"
      ],
      [
        "Q：有多名主人公同时打出希望+1，这些牌可以被友好禁止吗？",
        "A：可以，因为此时所有希望+1变为友好+1"
      ],
      [
        "Q：有多名主人公同时打出希望+1，这些牌再结算完毕后需要移除吗？",
        "A：不需要，因为此时所有希望+1变为友好+1"
      ],
      [
        "Q：绝望+1可以被密谋禁止吗？",
        "A：不能"
      ],
      [
        "Q：达成了复数的获得希望+1或绝望+1的条件，下一轮开始时获得几张？",
        "A：只有1张"
      ],
      [
        "Q：1L1是什么？",
        "A：每轮限1次的友好能力"
      ],
      [
        "Q：十周年规则之后WM的剧本怎么办？",
        "A：所有现存的WM剧本加特规【角色的1L1被拒绝之后视为已经使用过】"
      ],
      [
        "Q：已沟通标志能被鉴别员移动吗？",
        "A：不能，标志不是指示物"
      ],
      [
        "Q：已死亡标志能被鉴别员移动吗？",
        "A：不能，标志不是指示物"
      ],
      [
        "Q：傀儡无视友好是什么？",
        "A：【任意能力：主人公能力阶段】该角色可以拒绝主人公的友好能力请求。\n\n【任意能力：剧作家能力阶段】剧作家可以使用该角色的友好能力（需满足指示物数量条件）。此时需要声明使用能力的角色和对象"
      ],
      [
        "Q：傀儡无视友好是无视友好吗？",
        "A：是无视友好的一种"
      ],
      [
        "Q：希望和绝望指示物在计算种类的时候算几种？",
        "A：各算1种，计算种类时不统计指示物数量"
      ]
    ],
    [
      [
        "Q：用了+规则，必须要追加因果残片吗？",
        "A：如果剧本中有平民就必须选1名平民变为因果残片，如果没有则可以不追加"
      ],
      [
        "Q：用了+规则，局外人可以是因果残片吗？",
        "A：不能"
      ],
      [
        "Q：用了+规则，模仿犯可以模仿因果残片吗？",
        "A：如果剧本中有，可以"
      ]
    ],
    [
      [
        "Q：类似【所有区域均也视为学校】这类的特规，应该如何理解？",
        "A：将所有文本为【学校】的地方替换为【学校，都市，医院，神社和远方】"
      ],
      [
        "Q：类似【所有区域均也视为学校】这类的特规，角色初始和禁行区域还有效吗？",
        "A：初始和禁行区域没有文本表示，因此依然存在"
      ],
      [
        "Q：【与塔在同区域的平民变成杀人狂】这类的特规和【妄想扩大病毒】哪个更优先？",
        "A：先达成哪个条件哪个优先"
      ]
