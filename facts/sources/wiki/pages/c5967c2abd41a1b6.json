n<tr>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td></tr>\n<tr>\n<td rowspan=\"7\">支\n<p>线\n</p>\n</td>\n<td>好友圈\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>②\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td></tr>\n<tr>\n<td>恋爱风景线\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>①\n</td>\n<td>①\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td></tr>\n<tr>\n<td>不安的传言\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>【任意能力：剧作家能力阶段】往任意1名角色身上上放置1枚[密谋]（每轮限1次）（关键人物和刺客除外）\n</td></tr>\n<tr>\n<td>因果线\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>【强制：轮回开始时】上轮轮回结束时所有带有[友好]的角色，全部放置2枚[不安]\n</td></tr>\n<tr>\n<td>失恋13天\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>①\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>②\n</td>\n<td>\n</td></tr>\n<tr>\n<td>潜伏的杀人狂\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>①\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>①\n</td>\n<td>\n</td>\n<td>\n</td></tr>\n<tr>\n<td>妄想扩大病毒\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>【强制：常驻】某1名平民角色有2枚或以上[密谋]时，那名平民身份变为杀人狂\n</td></tr>\n<tr>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td></tr>\n<tr>\n<td rowspan=\"17\">身\n<p>份\n</p>\n</td>\n<td>\n</td>\n<td>限\n</td>\n<td colspan=\"5\">身份特性\n</td>\n<td colspan=\"6\">\n</td></tr>\n<tr>\n<td>关键人物\n</td>\n<td>\n</td>\n<td colspan=\"5\">\n</td>\n<td colspan=\"6\">【强制：该角色死亡时】主人公失败，当前轮回立即结束\n</td></tr>\n<tr>\n<td rowspan=\"2\">杀手\n</td>\n<td rowspan=\"2\">\n</td>\n<td colspan=\"5\" rowspan=\"2\">无视友好\n</td>\n<td colspan=\"6\">【任意能力：回合结束阶段】同一区域1名关键人物身上有2枚或以上[密谋]→那名关键人物死亡\n</td></tr>\n<tr>\n<td colspan=\"6\">【任意能力：回合结束阶段】该角色身上有4枚或以上[密谋]→主人公死亡\n</td></tr>\n<tr>\n<td>主谋\n</td>\n<td>\n</td>\n<td colspan=\"5\">无视友好\n</td>\n<td colspan=\"6\">【任意能力：剧作家能力阶段】往同一区域任意一名角色身上，或该角色所在的版图上放置1枚[密谋]\n</td></tr>\n<tr>\n<td>恶灵乌基\n</td>\n<td>\n</td>\n<td colspan=\"5\">必定无视友好\n</td>\n<td colspan=\"6\">【任意能力：行动结算阶段】可以无效化同一区域中任意角色身上和该角色所在版图上放置的禁止移动和禁止密谋\n</td></tr>\n<tr>\n<td>魔女\n</td>\n<td>\n</td>\n<td colspan=\"5\">必定无视友好\n</td>\n<td colspan=\"6\">\n</td></tr>\n<tr>\n<td rowspan=\"3\">刺客\n</td>\n<td rowspan=\"3\">\n</td>\n<td colspan=\"5\" rowspan=\"3\">\n</td>\n<td colspan=\"6\">【任意能力：回合结束阶段】该角色身上有5枚或以上[密谋]→主人公死亡\n</td></tr>\n<tr>\n<td colspan=\"6\">【任意能力：回合结束阶段】学校有3枚或以上[密谋]→主人公死亡\n</td></tr>\n<tr>\n<td colspan=\"6\">【任意能力：回合结束阶段】同一区域1名角色身上有2枚或以上[密谋]→那名角色死亡\n</td></tr>\n<tr>\n<td rowspan=\"2\">亲友\n</td>\n<td rowspan=\"2\">②\n</td>\n<td colspan=\"5\" rowspan=\"2\">\n</td>\n<td colspan=\"6\">【失败条件：轮回结束时】该卡牌为死亡状态，此时，需要告知主人公该卡牌的身份\n</td></tr>\n<tr>\n<td colspan=\"6\">【强制：轮回开始时】该角色身份曾被公开→往该角色身上放置1枚[友好]\n</td></tr>\n<tr>\n<td>心上人\n</td>\n<td>\n</td>\n<td colspan=\"5\">\n</td>\n<td colspan=\"6\">【强制：求爱者死亡时】往该角色身上放置6枚[不安]\n</td></tr>\n<tr>\n<td rowspan=\"2\">求爱者\n</td>\n<td rowspan=\"2\">\n</td>\n<td colspan=\"5\" rowspan=\"2\">\n</td>\n<td colspan=\"6\">【强制：心上人死亡时】往该角色身上放置6枚[不安]\n</td></tr>\n<tr>\n<td colspan=\"6\">【任意能力：回合结束阶段】该角色身上有1枚或以上[密谋]且有3枚或以上[不安]→主人公死亡\n</td></tr>\n<tr>\n<td>杀人狂\n</td>\n<td>\n</td>\n<td colspan=\"5\">\n</td>\n<td colspan=\"6\">【强制：回合结束阶段】仅有1名角色与该角色位于同一区域→那名角色死亡\n</td></tr>\n<tr>\n<td>暴徒\n</td>\n<td>\n</td>\n<td colspan=\"5\">无视友好\n</td>\n<td colspan=\"6\">\n</td></tr>\n<tr>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td></tr>\n<tr>\n<td rowspan=\"7\">事\n<p>件\n</p>\n</td>\n<td>事件名称\n</td>\n<td colspan=\"12\">效果\n</td></tr>\n<tr>\n<td>不安扩散\n</td>\n<td colspan=\"12\">往任意1名角色身上放置2枚[不安]，随后往另外1名角色身上放置1枚[密谋]\n</td></tr>\n<tr>\n<td>谋杀\n</td>\n<td colspan=\"12\">与当事人位于同一区域的另外1名角色死亡\n</td></tr>\n<tr>\n<td>邪气污染\n</td>\n<td colspan=\"12\">往神社放置2枚[密谋]\n</td></tr>\n<tr>\n<td>医院事故(小)\n</td>\n<td colspan=\"12\">医院有1枚或以上[密谋]→位于医院的所有角色死亡\n</td></tr>\n<tr>\n<td>自杀\n</td>\n<td colspan=\"12\">当事人死亡\n</td></tr>\n<tr>\n<td>失踪\n</td>\n<td colspan=\"12\">将当事人移动至任意版图，随后，往当事人所在版图放置1枚[密谋]\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260927032826\nCache expiry: 1209600\nReduced expiry: false\nComplications: []\nCPU time usage: 0.028 seconds\nReal time usage: 0.030 seconds\nPreprocessor visited node count: 1/1000000\nPost‐expand include size: 0/2097152 bytes\nTemplate argument size: 0/2097152 bytes\nHighest expansion depth: 1/100\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%    0.000      1 -total\n-->\n\n<!-- Saved in parser cache with key 1.43.9_prod_zhtragedyrooper:pcache:idhash:267-0!sseVary=RegularPage!zh-cn!FandomDesktop!LegacyGalleries and timestamp 20260927032826 and revision id 403. Rendering was triggered because: page-view\n -->\n</div>",
