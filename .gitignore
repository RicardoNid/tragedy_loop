# Generated dependencies and outputs
node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
coverage/
*.tsbuildinfo
*.egg-info/
playwright-report/
test-results/

# Local archive of environments, source clones and previous run evidence
/archive/local-only/

# Local credentials and machine files
.env
.env.*
!.env.example
.DS_Store

# Preserve pre-existing source-material ignore rules
*.pdf
facts/source_material/scans/*
!facts/source_material/scans/.gitkeep
facts/source_material/**/*.png
facts/source_material/**/*.jpg
facts/source_material/**/*.jpeg
facts/source_material/**/*.webp
facts/source_material/**/*.tif
facts/source_material/**/*.tiff

# Local runtime and import directories
runtime/
.sources/
.local-imports/
*$py.class
