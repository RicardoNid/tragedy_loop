{
  "name": "lunhui-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx apps/cli/demo.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "baseline": "tsx scripts/baseline.ts",
    "check": "pnpm baseline && pnpm format:check && pnpm typecheck && pnpm test",
    "gui": "tsx apps/web/server.ts",
    "gui:build": "vite build apps/web",
    "gui:test": "playwright test",
    "gui:test:headed": "playwright test --headed",
    "gui:test:report": "playwright show-report"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.15.30",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.25.0"
}
